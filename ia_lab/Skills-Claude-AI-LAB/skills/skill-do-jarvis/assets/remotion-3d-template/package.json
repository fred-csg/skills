{
  "name": "planta-3d-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Planta3D out/planta-3d.mp4 --gl=angle --concurrency=8",
    "still": "remotion still Planta3D",
